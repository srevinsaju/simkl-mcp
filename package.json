{
  "name": "simkl-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Simkl API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "openapi": "mkdir -p generated && bunx apib2swagger -i specs/apiary.apib -o generated/simkl-openapi3.json --open-api-3",
    "codegen": "bun run openapi && bun run scripts/codegen.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "simkl",
    "tracking",
    "anime",
    "movies",
    "tv-shows"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.2.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "agents": "^0.24.0",
    "oauth4webapi": "^3.8.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^22",
    "typescript": "^7.0.2",
    "wrangler": "^4.146.0"
  }
}
